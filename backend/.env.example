# ─────────────────────────────────────────────────────────────
# TQ Chatbot #1 — Backend environment
#
# Every value below is OPTIONAL for local demo. With NO keys set,
# the backend runs against a local SQLite DB and a deterministic
# mock "closer" LLM, so the full system works out of the box.
# Add real keys to switch each subsystem to production.
# ─────────────────────────────────────────────────────────────

# Supabase — if unset, falls back to local SQLite at backend/tq.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM priority: Groq → Gemini → deterministic mock (whichever key is set first).

# Groq (recommended primary — OpenAI-compatible, fast, generous free tier).
# Each chat message makes 2 LLM calls (reply + scoring); the scoring call uses
# the cheaper/faster GROQ_SCORING_MODEL so it doesn't compete for quota.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SCORING_MODEL=llama-3.1-8b-instant

# Gemini Flash (fallback). NOTE: gemini-2.5-flash free tier is only ~20 req/day —
# a live chatbot exhausts it fast. Prefer Groq, or enable billing on the project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hot-lead notifications: a single fire-and-forget POST to a per-tenant n8n
# webhook (configured per tenant via the `n8n_webhook_url` field, not here).
# n8n handles the downstream fan-out (email, Slack, CRM, etc).

# Admin API key — protects /tenant and /leads write/read endpoints
# Change this for any real deployment.
ADMIN_API_KEY=tq-admin-dev-key

# Public dashboard URL used inside notifications
DASHBOARD_URL=https://tq-demo.aquryu.space

# CORS — comma separated origins, or * for all (demo default)
CORS_ORIGINS=*
