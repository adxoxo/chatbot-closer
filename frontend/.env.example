# Frontend environment (Vite)
# The API is served under /api (FastAPI serves both the SPA and the API on one origin).
# Local dev (Vite :5173 → backend :8000):
VITE_API_BASE_URL=http://localhost:8000/api
# Production single-origin (set in .env.production): https://chat.aquryu.space/api
VITE_ADMIN_API_KEY=tq-admin-dev-key
# Origin the embed snippets point at (defaults to current origin)
VITE_WIDGET_ORIGIN=
# Default tenant id used by the demo widget route (/widget without ?tenant=)
VITE_DEMO_TENANT_ID=
